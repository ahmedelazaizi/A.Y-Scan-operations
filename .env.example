# A.Y Scan configuration. The Windows installer generates .env from this file
# and fills every secret with a random value; never commit a real .env.

# API server. HOST=127.0.0.1 keeps the app on this machine only; set HOST=0.0.0.0
# to let other workstations on the clinic network open it.
PORT=3001
HOST=127.0.0.1
NODE_ENV=production

# PostgreSQL (Docker). POSTGRES_PASSWORD has no default on purpose.
POSTGRES_DB=ayscan
POSTGRES_USER=ayscan
POSTGRES_PASSWORD=
POSTGRES_PORT=55433
DATABASE_URL=postgresql://ayscan:CHANGE_ME@localhost:55433/ayscan

# Time zone that defines "today" on the dashboard and in reports.
APP_TIMEZONE=Africa/Cairo

# Comma-separated browser origins allowed to call the API cross-origin.
# Leave empty in production: the API serves the web app from the same origin.
CORS_ORIGIN=

# Development only: run without PostgreSQL (data is lost on restart). Ignored when NODE_ENV=production.
ALLOW_IN_MEMORY_STORE=false

# Apply pending database migrations automatically when the server starts.
MIGRATE_ON_START=true

# First-run only: when the database has no users yet, the server creates this admin account.
# Leave empty to get the default account (username: admin, password: admin123); change it after the first sign-in.
AUTH_ADMIN_USERNAME=
AUTH_ADMIN_PASSWORD=
AUTH_ADMIN_DISPLAY_NAME=
