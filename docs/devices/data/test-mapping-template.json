 "_readme": "Starter catalog. LOINC codes verified 2026-10-13 against the HL7 terminology server (tx.fhir.org, LOINC 2.82) by $lookup; null = not verified. SI conversion hints in commonReferenceNote are general knowledge and must be validated. No reference ranges are given: the lab director owns them. 'mmol/mol' for HbA1c needs IFCC conversion, not a simple factor.",
 "mappingFormat": {
  "description": "Per-device mapping row stored by the app: maps an instrument test code to our catalog code.",
  "schema": {
   "deviceId": "string - our device record id",
   "instrumentCode": "string - code as sent by the instrument (ASTM R.3 / HL7 OBX.3 component 1 or per vendor doc)",
   "testCode": "string - our catalog code (see tests[].code)",
   "unitConversion": {
    "factor": "number, result = raw*factor+offset",
    "offset": "number"
   },
   "resultType": "numeric | text | categorical | titer | semi-quantitative",
   "decimals": "integer - display rounding (null = keep as received)",
   "abnormalFlagMap": "object - instrument flag -> {flag: H|L|HH|LL|N|A|POS|NEG, critical: bool}",
   "notes": "string"
  },
  "examples": [
   {
    "deviceId": "dev-chem-01",
    "instrumentCode": "GLU",
    "testCode": "CHEM-GLU",
    "unitConversion": {
     "factor": 18.016,
     "offset": 0
    },
    "resultType": "numeric",
    "decimals": 0,
    "abnormalFlagMap": {
     "H": {
      "flag": "H",
      "critical": false
     },
     "L": {
      "flag": "L",
      "critical": false
     },
     "HH": {
      "flag": "HH",
      "critical": true
     },
     "LL": {
      "flag": "LL",
      "critical": true
     },
     "N": {
      "flag": "N",
      "critical": false
     }
    },
    "notes": "EXAMPLE ONLY: device reports mmol/L, app stores mg/dL (x18.016). Confirm unit setting on the real device."
   },
   {
    "deviceId": "dev-hema-01",
    "instrumentCode": "WBC",
    "testCode": "CBC-WBC",
    "unitConversion": {
     "factor": 1,
     "offset": 0
    },
    "resultType": "numeric",
    "decimals": 2,
    "abnormalFlagMap": {
     "H": {
      "flag": "H",
      "critical": false
     },
     "L": {
      "flag": "L",
      "critical": false
     },
     "*": {
      "flag": "A",
      "critical": false
     }
    },
    "notes": "EXAMPLE ONLY: 10^9/L equals 10^3/uL numerically. Instrument code is a placeholder; take it from the vendor LIS spec."
   }
  ]
 },
