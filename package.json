{
  "name": "ay-scan-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server:dev": "tsx watch server/index.ts",
    "server:build": "tsc -p tsconfig.server.json",
    "server:start": "node dist-server/server/index.js",
    "db:up": "docker compose -p ay-scan-local-v2 up -d ay-scan-postgres",
    "db:down": "docker compose -p ay-scan-local-v2 down",
    "db:migrate": "tsx server/migrate.ts",
    "db:migrate:prod": "node dist-server/server/migrate.js",
    "test": "tsx --test \"server/**/*.test.ts\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "^5.7.2",
    "react": "latest",
    "react-dom": "latest",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "typescript-eslint": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/node": "22.15.21",
    "@types/pg": "8.15.5",
    "tsx": "4.19.3"
  }
}
