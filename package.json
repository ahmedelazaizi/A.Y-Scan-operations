{
  "name": "ay-scan",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server:dev": "tsx watch server/index.ts",
    "server:build": "tsc -p tsconfig.server.json",
    "server:start": "node dist-server/server/index.js",
    "db:up": "docker compose -p ay-scan-local-v2 up -d ay-scan-postgres",
    "db:down": "docker compose -p ay-scan-local-v2 down",
    "db:migrate": "tsx server/migrate.ts",
    "db:migrate:prod": "node dist-server/server/migrate.js",
    "test": "tsx --test \"server/**/*.test.ts\"",
    "admin:create": "node dist-server/server/create-admin.js",
    "start": "node dist-server/server/index.js",
    "test:db": "tsx --test \"server/**/*.test.ts\"",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/build-release.ps1",
    "release:stage": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/build-release.ps1 -SkipInstaller"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/cairo": "5.1.1",
    "@fontsource/montserrat": "5.1.1",
    "@types/node": "22.15.21",
    "@types/pg": "8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.19.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=20.19"
  }
}
